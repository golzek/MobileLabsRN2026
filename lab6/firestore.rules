// firestore.rules
// Правила безпеки Firestore:
// Кожен користувач може читати та записувати ТІЛЬКИ свій власний документ.
// Валідація через request.auth.uid == userId.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Колекція users
    match /users/{userId} {
      // Читання: тільки автентифікований користувач і тільки свій документ
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Запис: тільки автентифікований користувач і тільки свій документ
      // + валідація полів (name — рядок, age — рядок або число, city — рядок)
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'age', 'city', 'email', 'createdAt', 'updatedAt'])
        && (request.resource.data.name is string)
        && (request.resource.data.city is string);
      
      // Видалення: тільки власник документа
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Всі інші документи — заборонені
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
